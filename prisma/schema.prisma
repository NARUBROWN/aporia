generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           String            @id @db.Text
  name         String            @db.Text
  document     Json              @default("{}")
  version      BigInt            @default(1)
  passwordHash String?           @map("password_hash") @db.Text
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  ownerId      String?           @map("owner_id") @db.Uuid
  owner        User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  snapshots    ProjectSnapshot[]
  sheets       ProjectSheet[]
  seedBatches  SeedBatch[]

  @@index([deletedAt])
  @@index([ownerId])
  @@index([ownerId, deletedAt, updatedAt(sort: Desc)])
  @@map("projects")
}

model User {
  id           String        @id @db.Uuid
  username     String        @unique @db.Text
  name         String        @db.Text
  passwordHash String        @map("password_hash") @db.Text
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  termsAgreedAt   DateTime   @map("terms_agreed_at") @db.Timestamptz(6)
  privacyAgreedAt DateTime   @map("privacy_agreed_at") @db.Timestamptz(6)
  termsVersion    String     @map("terms_version") @db.Text
  privacyVersion  String     @map("privacy_version") @db.Text
  theme            String     @default("indigo-lavender") @db.Text
  sessions     AuthSession[]
  projects     Project[]

  @@index([deletedAt])
  @@map("users")
}

model AuthSession {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model ProjectSheet {
  id                String                  @id @db.Uuid
  projectId         String                  @map("project_id") @db.Text
  name              String                  @db.Text
  physicalTableName String                  @unique @map("physical_table_name") @db.Text
  color             String?                 @db.Text
  comment           String?                 @db.Text
  displayOrder      Int                     @default(0) @map("display_order")
  origin            String                  @default("manual") @db.Text
  seedBatchId       String?                 @map("seed_batch_id") @db.Uuid
  rowCount          BigInt                  @default(0) @map("row_count")
  dataRevision      BigInt                  @default(0) @map("data_revision")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  project           Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seedBatch         SeedBatch?              @relation(fields: [seedBatchId], references: [id], onDelete: SetNull)
  columns           SheetColumn[]
  outgoingRelations SheetRelation[]         @relation("RelationSourceSheet")
  incomingRelations SheetRelation[]         @relation("RelationTargetSheet")
  calculatedFields  CalculatedFieldRecord[]

  @@unique([projectId, name])
  @@index([projectId, displayOrder, createdAt])
  @@map("project_sheets")
}

model SheetColumn {
  id                    String                 @id @db.Uuid
  sheetId               String                 @map("sheet_id") @db.Uuid
  name                  String                 @db.Text
  physicalColumnName    String                 @map("physical_column_name") @db.Text
  dataType              String                 @map("data_type") @db.Text
  displayOrder          Int                    @default(0) @map("display_order")
  color                 String?                @db.Text
  comment               String?                @db.Text
  nullable              Boolean                @default(true)
  primaryKey            Boolean                @default(false) @map("primary_key")
  sheet                 ProjectSheet           @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  sourceRelations       SheetRelation[]        @relation("RelationSourceColumn")
  targetRelations       SheetRelation[]        @relation("RelationTargetColumn")
  calculationConditions CalculationCondition[]

  @@unique([sheetId, name])
  @@unique([sheetId, physicalColumnName])
  @@index([sheetId, displayOrder])
  @@map("sheet_columns")
}

model SheetRelation {
  id             String       @id @db.Uuid
  sourceSheetId  String       @map("source_sheet_id") @db.Uuid
  sourceColumnId String       @map("source_column_id") @db.Uuid
  targetSheetId  String       @map("target_sheet_id") @db.Uuid
  targetColumnId String       @map("target_column_id") @db.Uuid
  relationType   String       @map("relation_type") @db.Text
  relationOrigin String       @default("manual") @map("relation_origin") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceSheet    ProjectSheet @relation("RelationSourceSheet", fields: [sourceSheetId], references: [id], onDelete: Cascade)
  targetSheet    ProjectSheet @relation("RelationTargetSheet", fields: [targetSheetId], references: [id], onDelete: Cascade)
  sourceColumn   SheetColumn  @relation("RelationSourceColumn", fields: [sourceColumnId], references: [id], onDelete: Cascade)
  targetColumn   SheetColumn  @relation("RelationTargetColumn", fields: [targetColumnId], references: [id], onDelete: Cascade)

  @@unique([sourceColumnId, targetColumnId])
  @@index([sourceSheetId, createdAt])
  @@index([targetSheetId])
  @@map("sheet_relations")
}

model CalculatedFieldRecord {
  id           String                 @id @db.Uuid
  sheetId      String                 @map("sheet_id") @db.Uuid
  name         String                 @db.Text
  fieldType    String                 @map("field_type") @db.Text
  color        String?                @db.Text
  displayOrder Int                    @default(0) @map("display_order")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  sheet        ProjectSheet           @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  rules        CalculationRule[]
  conditions   CalculationCondition[]

  @@unique([sheetId, name])
  @@index([sheetId, displayOrder])
  @@map("calculated_fields")
}

model CalculationRule {
  id                String                @id @db.Uuid
  calculatedFieldId String                @map("calculated_field_id") @db.Uuid
  stepOrder         Int                   @map("step_order")
  operation         String                @db.Text
  arguments         Json                  @default("{}")
  calculatedField   CalculatedFieldRecord @relation(fields: [calculatedFieldId], references: [id], onDelete: Cascade)

  @@unique([calculatedFieldId, stepOrder])
  @@map("calculation_rules")
}

model CalculationCondition {
  id                String                @id @db.Uuid
  calculatedFieldId String                @map("calculated_field_id") @db.Uuid
  sourceColumnId    String?               @map("source_column_id") @db.Uuid
  conditionOrder    Int                   @map("condition_order")
  operator          String                @db.Text
  operandType       String                @map("operand_type") @db.Text
  operandValue      String?               @map("operand_value") @db.Text
  calculatedField   CalculatedFieldRecord @relation(fields: [calculatedFieldId], references: [id], onDelete: Cascade)
  sourceColumn      SheetColumn?          @relation(fields: [sourceColumnId], references: [id], onDelete: SetNull)

  @@unique([calculatedFieldId, conditionOrder])
  @@map("calculation_conditions")
}

model SeedBatch {
  id             String         @id @db.Uuid
  projectId      String         @map("project_id") @db.Text
  sourceFilename String         @map("source_filename") @db.Text
  sourceHash     String         @map("source_hash") @db.Text
  status         String         @default("pending") @db.Text
  importedRows   BigInt         @default(0) @map("imported_rows")
  failedRows     BigInt         @default(0) @map("failed_rows")
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sheets         ProjectSheet[]
  errors         SeedError[]

  @@unique([projectId, sourceHash])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("seed_batches")
}

model SeedError {
  id           String    @id @db.Uuid
  seedBatchId  String    @map("seed_batch_id") @db.Uuid
  sourceTable  String    @map("source_table") @db.Text
  sourceRow    BigInt?   @map("source_row")
  errorCode    String    @map("error_code") @db.Text
  errorMessage String    @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  seedBatch    SeedBatch @relation(fields: [seedBatchId], references: [id], onDelete: Cascade)

  @@index([seedBatchId, sourceTable])
  @@map("seed_errors")
}

model ProjectSnapshot {
  id             String   @id @db.Text
  projectId      String   @map("project_id") @db.Text
  document       Json
  projectVersion BigInt   @map("project_version")
  reason         String   @default("manual") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sheets         SnapshotSheet[]
  relations      SnapshotRelation[]
  calculatedFields SnapshotCalculatedField[]

  @@index([projectId, createdAt(sort: Desc)])
  @@map("project_snapshots")
}

model SnapshotSheet {
  id              String          @id @db.Uuid
  snapshotId      String          @map("snapshot_id") @db.Text
  originalSheetId String          @map("original_sheet_id") @db.Text
  name            String          @db.Text
  color           String?         @db.Text
  comment         String?         @db.Text
  displayOrder    Int             @map("display_order")
  snapshot        ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  columns         SnapshotColumn[]
  rows            SnapshotRow[]

  @@unique([snapshotId, originalSheetId])
  @@index([snapshotId, displayOrder])
  @@map("snapshot_sheets")
}

model SnapshotColumn {
  id               String        @id @db.Uuid
  snapshotSheetId  String        @map("snapshot_sheet_id") @db.Uuid
  name             String        @db.Text
  dataType         String        @map("data_type") @db.Text
  color            String?       @db.Text
  comment          String?       @db.Text
  displayOrder     Int           @map("display_order")
  snapshotSheet    SnapshotSheet @relation(fields: [snapshotSheetId], references: [id], onDelete: Cascade)
  cells            SnapshotCell[]

  @@unique([snapshotSheetId, name])
  @@index([snapshotSheetId, displayOrder])
  @@map("snapshot_columns")
}

model SnapshotRow {
  id              String        @id @db.Uuid
  snapshotSheetId String        @map("snapshot_sheet_id") @db.Uuid
  originalRowId   String        @map("original_row_id") @db.Text
  rowOrder        Int           @map("row_order")
  snapshotSheet   SnapshotSheet @relation(fields: [snapshotSheetId], references: [id], onDelete: Cascade)
  cells           SnapshotCell[]

  @@unique([snapshotSheetId, originalRowId])
  @@index([snapshotSheetId, rowOrder])
  @@map("snapshot_rows")
}

model SnapshotCell {
  rowId    String         @map("row_id") @db.Uuid
  columnId String         @map("column_id") @db.Uuid
  value    String?        @db.Text
  row      SnapshotRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)
  column   SnapshotColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@id([rowId, columnId])
  @@map("snapshot_cells")
}

model SnapshotRelation {
  id                    String          @id @db.Uuid
  snapshotId            String          @map("snapshot_id") @db.Text
  originalRelationId    String          @map("original_relation_id") @db.Text
  sourceSheetOriginalId String          @map("source_sheet_original_id") @db.Text
  sourceColumn          String          @map("source_column") @db.Text
  targetSheetOriginalId String          @map("target_sheet_original_id") @db.Text
  targetColumn          String          @map("target_column") @db.Text
  relationType          String          @map("relation_type") @db.Text
  relationOrigin        String          @default("manual") @map("relation_origin") @db.Text
  updateOption          String?         @map("update_option") @db.Text
  displayOrder          Int             @map("display_order")
  snapshot              ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  links                 SnapshotRelationLink[]

  @@unique([snapshotId, originalRelationId])
  @@index([snapshotId, displayOrder])
  @@map("snapshot_relations")
}

model SnapshotRelationLink {
  id          String           @id @db.Uuid
  relationId  String           @map("relation_id") @db.Uuid
  sourceRowId String           @map("source_row_id") @db.Text
  targetRowId String           @map("target_row_id") @db.Text
  linkOrder   Int              @map("link_order")
  relation    SnapshotRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@unique([relationId, linkOrder])
  @@map("snapshot_relation_links")
}

model SnapshotCalculatedField {
  id                    String          @id @db.Uuid
  snapshotId            String          @map("snapshot_id") @db.Text
  originalFieldId       String          @map("original_field_id") @db.Text
  resultSheetOriginalId String          @map("result_sheet_original_id") @db.Text
  name                  String          @db.Text
  fieldType             String          @map("field_type") @db.Text
  color                 String?         @db.Text
  displayOrder          Int             @map("display_order")
  snapshot              ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  rules                 SnapshotCalculationRule[]
  conditions            SnapshotCalculationCondition[]

  @@unique([snapshotId, originalFieldId])
  @@index([snapshotId, displayOrder])
  @@map("snapshot_calculated_fields")
}

model SnapshotCalculationRule {
  id                       String                  @id @db.Uuid
  snapshotCalculatedFieldId String                 @map("snapshot_calculated_field_id") @db.Uuid
  stepOrder                Int                     @map("step_order")
  operation                String                  @db.Text
  arguments                Json                    @default("{}")
  calculatedField          SnapshotCalculatedField @relation(fields: [snapshotCalculatedFieldId], references: [id], onDelete: Cascade)

  @@unique([snapshotCalculatedFieldId, stepOrder])
  @@map("snapshot_calculation_rules")
}

model SnapshotCalculationCondition {
  id                       String                  @id @db.Uuid
  snapshotCalculatedFieldId String                 @map("snapshot_calculated_field_id") @db.Uuid
  conditionOrder           Int                     @map("condition_order")
  sourceSheetOriginalId    String?                 @map("source_sheet_original_id") @db.Text
  sourceColumn             String?                 @map("source_column") @db.Text
  operator                 String                  @db.Text
  operandType              String                  @map("operand_type") @db.Text
  operandValue             String?                 @map("operand_value") @db.Text
  calculatedField          SnapshotCalculatedField @relation(fields: [snapshotCalculatedFieldId], references: [id], onDelete: Cascade)

  @@unique([snapshotCalculatedFieldId, conditionOrder])
  @@map("snapshot_calculation_conditions")
}
